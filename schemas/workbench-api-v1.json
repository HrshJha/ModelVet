          "id",
          "label",
          "created_at",
          "decision",
          "reason",
          "rule_ids",
          "manifest_digest",
          "semantic_digest",
          "policy_id",
          "file_count",
          "total_bytes",
          "required_complete",
          "required_total",
          "findings_count",
          "conflicts_count"
        ],
        "title": "ReportSummary",
        "type": "object"
      },
      "ScanInput": {
        "additionalProperties": false,
        "properties": {
          "max_file_mib": {
            "default": 1024,
            "maximum": 1024.0,
            "minimum": 1.0,
            "title": "Max File Mib",
            "type": "integer"
          },
          "max_files": {
            "default": 10000,
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Files",
            "type": "integer"
          },
          "max_total_mib": {
            "default": 2048,
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Max Total Mib",
            "type": "integer"
          },
          "model_path": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Model Path",
            "type": "string"
          },
          "policy_id": {
            "default": "default",
            "maxLength": 80,
            "title": "Policy Id",
            "type": "string"
          },
          "scanner": {
            "default": "auto",
